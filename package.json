{
  "name": "lorume",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "bin": {
    "lorume": "scripts/lorume.mjs"
  },
  "scripts": {
    "dev": "VITE_LORUME_APP_MODE=${VITE_LORUME_APP_MODE:-development} vite --host 0.0.0.0",
    "dev:backend": "LORUME_APP_MODE=${LORUME_APP_MODE:-development} tsx src/backend/backend-server.ts",
    "dev:backend-e2e": "tsx scripts/dev-backend-e2e.ts",
    "dev:e2e": "tsx scripts/dev-e2e.ts",
    "db:up": "docker compose up -d postgres",
    "db:setup": "node scripts/db-setup.mjs",
    "build": "tsc -b && vite build",
    "build:backend": "vite build --config vite.backend.config.ts",
    "start:backend": "node dist/backend/backend-server.mjs",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "setup:e2e": "playwright install chromium",
    "verify": "./scripts/verify.sh",
    "check": "npm run verify",
    "check:full": "npm run verify",
    "check:commit-message": "vitest run scripts/check-commit-message.test.mjs",
    "check:device-package-version": "node scripts/check-device-package-version.mjs && vitest run scripts/check-device-package-version.test.mjs",
    "check:cli": "vitest run src/cli",
    "check:repo": "./scripts/check-repo.sh",
    "check:backend": "vitest run src/auth/auth-crypto.test.ts src/auth/auth-http-api.test.ts src/agent-analysis src/backend src/server src/operations src/notifications src/runtime/device-collector-script.test.ts",
    "check:backend:e2e": "npm run test:backend-e2e",
    "check:backend:standalone": "vitest run src/backend",
    "check:db": "npm run db:up && LORUME_RUN_DB_TESTS=1 LORUME_TEST_DATABASE_URL=postgres://lorume:lorume@127.0.0.1:54329/postgres vitest run src/auth/auth-store.test.ts src/agent-analysis/agent-analysis-store.test.ts src/server/db-schema.test.ts src/server/postgres-store.test.ts src/server/runtime-http-api-postgres.test.ts src/backend/backend-server.test.ts src/operations/operation-store.test.ts src/notifications/notification-store.test.ts",
    "check:runtime": "vitest run src/runtime",
    "check:quick": "npm run typecheck && npm run test:run",
    "check:build": "npm run build",
    "check:deploy": "npm run build:backend && node scripts/check-deploy-config.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "check:e2e": "npm run test:e2e",
    "harness": "npm run check:full",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:backend-e2e": "env -u NO_COLOR playwright test -c playwright.backend.config.ts",
    "test:run": "vitest run",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:install": "npm run setup:e2e"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@types/ws": "^8.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.18",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
